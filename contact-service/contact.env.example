# Copy to /etc/contact-service.env (mode 600, owner root). Never commit real values.
# Relay mode: Google Workspace SMTP relay, server IP allowlisted, TLS required, no credentials.
SMTP_HOST=smtp-relay.gmail.com
MAIL_FROM=web@umtelkomd.com
MAIL_TO=administration@umtelkomd.com,ihorstmann@umtelkomd.com
# Login mode instead: set both, e.g. a Google app password.
# SMTP_USER=web@umtelkomd.com
# SMTP_PASSWORD=change-me
# SMTP_PORT=587
# PORT=8787
