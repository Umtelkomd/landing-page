[Unit]
Description=UMTELKOMD contact form relay
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/contact-service.env
ExecStart=/usr/bin/python3 /opt/contact-service/contact_service.py
User=contact
Group=contact
Restart=on-failure
RestartSec=5
# Hardening: the service only needs outbound SMTP and a loopback socket.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Measured: one request with a 5 MB CV peaks at ~60 MB in the stdlib MIME parser (~70-80 MB RSS
# per request end to end). The service handles at most 2 bodies at once (MAX_CONCURRENT), others get 503.
MemoryMax=256M

[Install]
WantedBy=multi-user.target
